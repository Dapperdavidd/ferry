NODE_ENV=production
PORT=8000
DATABASE_URL=

JWT_SECRETS=
JWT_EXPIRES_IN=7d

# Monad mainnet. Use at least two independently operated RPC providers in production.
MONAD_CHAIN_ID=143
MONAD_RPC_URLS=https://rpc.monad.xyz,https://rpc1.monad.xyz
EXPLORER_URL=https://monadscan.com

# Agora Dollar on Monad mainnet. Mainnet has no faucet.
AUSD_ADDRESS=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
AUSD_FAUCET_ADDRESS=

# Keep settlement disabled until Ferry has a production pair and Agora whitelist.
CTK_ADDRESS=
STABLE_SWAP_PAIR_ADDRESS=
STABLE_SWAP_WHITELISTER_ADDRESS=
SETTLEMENT_ADDRESS=

# Fill after the chain-locked mainnet deployment and record the deployment block.
FLOW_CONTRACT_ADDRESS=
DROP_CONTRACT_ADDRESS=
FLOW_DEPLOYMENT_BLOCK=0

# Dedicated production relayer. Never reuse the deployer key.
RELAYER_PRIVATE_KEY=
RELAYER_MAX_SENDS_PER_USER_PER_DAY=20
RELAYER_MAX_AMOUNT_PER_USER_PER_DAY_RAW=5000000000
RELAYER_LOW_BALANCE_WEI=2000000000000000000

# Ferry Plus: 9.99 AUSD for 30 days. Set the public treasury address to enable
# onchain purchases; never place the treasury private key in this service.
FERRY_PLUS_TREASURY_ADDRESS=
FERRY_PLUS_PRICE_RAW=9990000
FERRY_PLUS_DURATION_DAYS=30
FERRY_FREE_SPONSORED_SENDS=5
FERRY_PLUS_SPONSORED_SENDS=50

# Enable only after Agora has issued Ferry production API access.
AGORA_API_MODE=live
AGORA_API_URL=https://api.agora.finance
AGORA_API_KEY=

FX_SOURCE=table
EXPO_ACCESS_TOKEN=
CORS_ALLOWED_ORIGINS=

# Enable only after production KYB, webhook configuration, and a sandbox sign-off.
PAYOUT_PARTNER_ADDRESS=
PAYOUT_PROVIDER=disabled
PAYOUT_DATA_KEY=
YELLOW_CARD_ENV=production
YELLOW_CARD_API_KEY=
YELLOW_CARD_API_SECRET=
YELLOW_CARD_WEBHOOK_SECRET=
YELLOW_CARD_BUSINESS_NAME=Ferry
YELLOW_CARD_BUSINESS_ID=
YELLOW_CARD_SEND_REASON=gift
