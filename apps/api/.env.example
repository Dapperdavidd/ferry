NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://ferry:ferry@localhost:5432/ferry

# Rotating list, newest first. Tokens signed with any listed secret verify.
JWT_SECRETS=change-me-to-32-random-bytes
JWT_EXPIRES_IN=7d

# Monad testnet. Several RPC URLs, comma separated, tried in order.
MONAD_CHAIN_ID=10143
MONAD_RPC_URLS=https://testnet-rpc.monad.xyz,https://rpc.ankr.com/monad_testnet
EXPLORER_URL=https://testnet.monadscan.com

# Agora's contracts on that chain.
AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
AUSD_FAUCET_ADDRESS=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C
CTK_ADDRESS=0x7BEb5D9DB0d85cBEa543C04f0dE8c23c2176cd9D
STABLE_SWAP_PAIR_ADDRESS=0x1Aa8958Aa34cEC8096EF4381cb335effe977b0ae
STABLE_SWAP_WHITELISTER_ADDRESS=0x7c10F56d6f04a51376393a1C3670e966863F6BD5
# Ferry's settlement contract (FerrySettlement, contracts/). Empty disables cash-outs. Testnet: 0x7056D0D544b95ff1c004A588C42dE52e22011Da9
SETTLEMENT_ADDRESS=

# The relayer pays gas for every user action. Hex private key, never committed.
RELAYER_PRIVATE_KEY=
RELAYER_MAX_SENDS_PER_USER_PER_DAY=20
RELAYER_MAX_AMOUNT_PER_USER_PER_DAY_RAW=5000000000
RELAYER_LOW_BALANCE_WEI=2000000000000000000

# Agora's API. live needs AGORA_API_KEY (KYB'd organisations only); mock answers from the spec.
AGORA_API_MODE=mock
AGORA_API_URL=https://api.agora.finance
AGORA_API_KEY=

# Display FX rates for the recipient's currency. A fixed table in dev.
FX_SOURCE=table

# Expo push. The access token is optional for the free tier.
EXPO_ACCESS_TOKEN=

CORS_ALLOWED_ORIGINS=

# The Monad address that receives the output of Agora settlement. In production this is
# Ferry's payout treasury, which keeps the bank payout balance funded.
PAYOUT_PARTNER_ADDRESS=

# Real local-bank delivery. Leave disabled for chain-only development. Yellow Card keys
# are server secrets from a KYB'd partner account; never expose them to the mobile app.
PAYOUT_PROVIDER=disabled
PAYOUT_DATA_KEY=
YELLOW_CARD_ENV=sandbox
YELLOW_CARD_API_KEY=
YELLOW_CARD_API_SECRET=
YELLOW_CARD_WEBHOOK_SECRET=
YELLOW_CARD_BUSINESS_NAME=Ferry
YELLOW_CARD_BUSINESS_ID=
YELLOW_CARD_SEND_REASON=gift
