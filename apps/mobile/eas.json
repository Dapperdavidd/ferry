{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api-production-bc03d.up.railway.app",
        "EXPO_PUBLIC_MONAD_RPC_URL": "https://testnet-rpc.monad.xyz",
        "EXPO_PUBLIC_MONAD_CHAIN_ID": "10143",
        "EXPO_PUBLIC_AUSD_ADDRESS": "0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC",
        "EXPO_PUBLIC_EXPLORER_URL": "https://testnet.monadscan.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
