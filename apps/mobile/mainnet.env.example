# Ferry mainnet release. The backend must report the same chain and AUSD contract.
EXPO_PUBLIC_BACKEND_URL=https://api.ferry.money
EXPO_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
EXPO_PUBLIC_MONAD_CHAIN_ID=143
EXPO_PUBLIC_AUSD_ADDRESS=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
EXPO_PUBLIC_FLOW_CONTRACT_ADDRESS=
EXPO_PUBLIC_EXPLORER_URL=https://monadscan.com

# Never enable seed/demo state in a store build.
EXPO_PUBLIC_SEED_DEMO=false
