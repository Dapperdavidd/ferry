# Ferry mobile. Copy to .env. Everything here ships in the app bundle, so
# nothing secret belongs in this file.

# The Ferry API. For the Android emulator use 10.0.2.2 instead of localhost.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Monad testnet, read directly by the app only as a fallback for balances and
# for explorer links. Keyless public endpoint; never a provider key.
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_MONAD_CHAIN_ID=10143
EXPO_PUBLIC_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
EXPO_PUBLIC_EXPLORER_URL=https://testnet.monadscan.com

# Dev-only: skip the biometric app lock in a dev build (release always locks).
# EXPO_PUBLIC_DISABLE_APP_LOCK=false

# Dev-only: a populated, signed-in session with no backend and no passkey, for
# UI work. See utils/devSeed.ts.
# EXPO_PUBLIC_SEED_DEMO=false
