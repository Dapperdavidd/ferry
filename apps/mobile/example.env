# Ferry mobile. Copy to .env. Everything here ships in the app bundle, so
# nothing secret belongs in this file.

# Both networks ship in one app. These are public endpoints, never secrets.
EXPO_PUBLIC_MAINNET_BACKEND_URL=https://api-mainnet-aa27.up.railway.app
EXPO_PUBLIC_MAINNET_MONAD_RPC_URL=https://rpc.monad.xyz
EXPO_PUBLIC_MAINNET_AUSD_ADDRESS=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
EXPO_PUBLIC_MAINNET_FLOW_CONTRACT_ADDRESS=
EXPO_PUBLIC_MAINNET_EXPLORER_URL=https://monadscan.com

EXPO_PUBLIC_TESTNET_BACKEND_URL=http://localhost:8000
EXPO_PUBLIC_TESTNET_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_TESTNET_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
EXPO_PUBLIC_TESTNET_FLOW_CONTRACT_ADDRESS=0x77b0662bD04798E9982A2df4547929f6B0a46659
EXPO_PUBLIC_TESTNET_EXPLORER_URL=https://testnet.monadscan.com

# Dev-only: skip the biometric app lock in a dev build (release always locks).
# EXPO_PUBLIC_DISABLE_APP_LOCK=false

# Dev-only: a populated, signed-in session with no backend and no passkey, for
# UI work. See utils/devSeed.ts.
# EXPO_PUBLIC_SEED_DEMO=false
